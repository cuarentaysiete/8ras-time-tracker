{
  "id": "com.8ras.time-tracker.v2",
  "name": "8ras time tracker",
  "version": "2.5.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "manifestVersion": 5,
  "permissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "time-tracker-panel",
      "minimumSize": {
        "width": 300,
        "height": 380
      },
      "maximumSize": {
        "width": 640,
        "height": 800
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 540
      },
      "label": {
        "default": "8ras time tracker"
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "assets/icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light"
      ]
    }
  ]
}